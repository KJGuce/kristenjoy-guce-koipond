{
  "extends": "expo/tsconfig.base", // Inherits Expo's base TypeScript configuration
  "compilerOptions": {
    "strict": true, // Enables strict type checking
    "baseUrl": "./", // Allows non-relative imports starting from the project root
    "paths": {
      "@/*": ["./*"] // Maps "@/..." to the root of the project
    },
    "types": ["expo-router"] // Adds TypeScript types for Expo Router
  },
  "include": [
    "**/*.ts", // Includes all TypeScript files
    "**/*.tsx", // Includes all TSX files for React components
    ".expo/types/**/*.ts", // Includes additional Expo-generated type definitions
    "expo-env.d.ts" // Includes a file for environment type definitions (if it exists)
  ]
}
