{
  "expo": {
    "name": "KoiPond",
    "slug": "KoiPond",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-font",
        {
          "customFonts": {
            "Quicksand-Regular": "./assets/fonts/Quicksand-Regular.ttf",
            "Quicksand-Bold": "./assets/fonts/Quicksand-Bold.ttf",
            "Quicksand-Medium": "./assets/fonts/Quicksand-Medium.ttf",
            "Quicksand-Light": "./assets/fonts/Quicksand-Light.ttf",
            "Quicksand-SemiBold": "./assets/fonts/Quicksand-SemiBold.ttf"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
